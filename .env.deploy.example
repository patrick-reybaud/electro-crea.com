# Copier en .env.deploy (non versionné) et compléter.
# Accès SFTP de l'hébergement OVH (même identifiant que le FTP).
FTP_HOST=ssh.clusterXXX.hosting.ovh.net
FTP_USER=
FTP_PASSWORD=
# Dossier du multisite electro-crea.com, à côté de www/ (ondulab.com) et pacabot/ (pacabot.com)
FTP_REMOTE_DIR=electro-crea
